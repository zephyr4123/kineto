# 本机私有注入：scaffold 建的符号链接，指向本机绝对路径，换机器 / CI 上必然失效
CLAUDE.local.md
.claude/settings.local.json

# 密钥与本地环境变量（示例文件照常入库）
.env
.env.*
!.env.example

# 本机真实配置；入库的是带占位符的 kineto.config.example.yaml
kineto.config.yaml

# 依赖与本机运行态（资产缓存、暂存素材目录、渲染产物、本地存储后端）
node_modules/
.kineto/
out/

# 官方 Remotion skills 由 `kineto setup` 安装：上游仓库没有 LICENSE，不能随本仓库分发
.agents/skills/remotion-*
.claude/skills/remotion-*
skills-lock.json

# 系统与编辑器
.DS_Store
.idea/
.vscode/
*.swp

# 浏览器自动化（playwright MCP）的截图与日志
.playwright-mcp/
