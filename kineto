#!/usr/bin/env node
// kineto CLI 入口。CLI 与 kernel 直接以 TypeScript 源码运行（Node 原生类型剥离），无需编译；
// 这层纯 JS 外壳只负责在 Node 版本太旧时给出人话报错，而不是一个看不懂的语法错误。
// 类型剥离默认开启的版本：22.18+ 的 22.x，以及 23.6+（23.0–23.5 需要显式开关，不算支持）
const [major, minor] = process.versions.node.split(".").map(Number);
const supported = (major === 22 && minor >= 18) || (major === 23 && minor >= 6) || major >= 24;
if (!supported) {
  process.stderr.write(`kineto needs Node.js 22.18+ or 23.6+ (found ${process.versions.node}).\n`);
  process.exit(1);
}
await import("./cli/main.ts");
