{
  "name": "kineto",
  "version": "1.0.0",
  "description": "Agent-first video studio built on Remotion: one CLI to create, render and manage every video",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18 || >=23.6"
  },
  "bin": {
    "kineto": "./kineto"
  },
  "scripts": {
    "studio": "./kineto studio",
    "test": "node --test \"kernel/**/*.test.ts\" \"cli/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint --no-error-on-unmatched-pattern src engine videos templates",
    "verify": "npm run typecheck && npm run lint && npm test && ./kineto check --deep"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/lib-storage": "3.1146.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/captions": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/install-whisper-cpp": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "typescript": "7.0.2",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/node": "26.6.4",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1"
  }
}
