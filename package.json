{
  "name": "kineto",
  "version": "0.1.0",
  "description": "Agent-first video studio built on Remotion: one CLI to create, render and manage every video",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "kineto": "./kineto"
  },
  "scripts": {
    "studio": "./kineto studio",
    "test": "node --test \"kernel/**/*.test.ts\" \"cli/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint src engine videos templates",
    "verify": "npm run typecheck && npm run lint && npm test && ./kineto check"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532",
    "yaml": "2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.532",
    "@types/node": "26.6.4",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
